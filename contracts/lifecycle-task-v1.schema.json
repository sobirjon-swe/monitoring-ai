{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monitoring-ai:lifecycle-task:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "assignee_id", "estimate_basis", "remaining_effort", "expected_test_keys", "status", "criterion_links"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "assignee_id": {"type": "string", "format": "uuid"},
    "estimate_basis": {"type": "string", "minLength": 1, "maxLength": 4000},
    "remaining_effort": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "expected_test_keys": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "status": {"enum": ["unstarted", "in_progress", "blocked", "implemented_awaiting_verification", "done"]},
    "criterion_links": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "criterion_version_id"], "properties": {"criterion_id": {"type": "string", "format": "uuid"}, "criterion_version_id": {"type": "string", "format": "uuid"}}}},
    "source_receipt": {"type": "object", "additionalProperties": false, "required": ["connector_id", "source_instance_id", "source_object_type", "source_object_id", "receipt_id"], "properties": {"connector_id": {"type": "string", "format": "uuid"}, "source_instance_id": {"type": "string", "format": "uuid"}, "source_object_type": {"const": "ticket"}, "source_object_id": {"type": "string", "minLength": 1, "maxLength": 100}, "receipt_id": {"type": "string", "format": "uuid"}}}
  }
}
