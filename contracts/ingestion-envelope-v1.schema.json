{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_object_id", "source_version", "event_kind", "occurred_at", "source_updated_at", "payload"],
  "properties": {
    "version": {"const": "ingestion-v1"},
    "source_object_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "source_version": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "event_kind": {"const": "ticket.snapshot"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "source_updated_at": {"type": ["string", "null"], "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["external_project_id", "external_ticket_id", "title", "status", "external_actor_id", "due_at"],
      "properties": {
        "external_project_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "external_ticket_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
        "status": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
        "external_actor_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "due_at": {"type": ["string", "null"], "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    }
  }
}
